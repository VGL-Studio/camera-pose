root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
# Giới hạn chỉ áp cho dòng có code: ktlint bỏ qua dòng chỉ có chú thích (//, KDoc, /* */), không có tùy chọn bật lại.
# Chú thích dài không phải lỗi, rà soát không nêu (T-050).
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
# Dấu phẩy cuối giúp diff gọn khi thêm tham số hoặc phần tử.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_standard_filename = disabled

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2
