<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Every new permission is a high-risk change (risk-scoring.md, blocking point 3)
        and must match the Data safety declaration on Google Play.
    -->

    <!-- Camera preview and capture (spec camera). Photos are saved through MediaStore, so no storage permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <!--
        Watches the network to show the network dialog (spec network, KB-1). The ads and analytics SDKs already add it
        to the merged manifest; declared here so every permission of the app is seen in one place.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TemplateApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <!-- Set per build flavor in app/build.gradle.kts: Google's test app id in staging (ADR-0013). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
