#!/usr/bin/env bash
# Minimal stand-in for adb used by scripts/tests: one connected device with the app installed, unless
# FAKE_ADB_NO_DEVICE or FAKE_ADB_NO_APP is set. `logcat -v ...` prints $FAKE_ADB_LOGCAT, then waits to be killed
# like the real streaming logcat. `dumpsys connectivity` reports the default network $FAKE_ADB_NETWORK (default
# "none", i.e. offline). `exec-out cat` prints $FAKE_ADB_UI (a UI dump), `find /sdcard` prints $FAKE_ADB_FILES.
# Every call is appended to $FAKE_ADB_CALLS when set.
# `dumpsys package` lists $FAKE_ADB_RUNTIME_PERMISSIONS (space-separated) as runtime permissions; `pm grant` fails
# for the permissions in $FAKE_ADB_GRANT_FAILS. `query-activities` lists the LAUNCHER activities in $FAKE_ADB_LAUNCHERS
# (space-separated; default: one MainActivity).
# UI dumps for scripts/device-scenario.py: `uiautomator dump` takes the next file of $FAKE_ADB_UI_SEQ (space-separated
# paths; the count is kept in $FAKE_ADB_STATE_DIR/ui-seq.n, default $TMPDIR; the last file repeats) and `exec-out cat`
# prints it. A file named *.idle-error makes the dump print "ERROR: could not get idle state." and print nothing.
# $FAKE_ADB_HANG names a shell subcommand (for example uiautomator) that never returns. `wm size` and `wm density`
# report a $FAKE_ADB_PHYSICAL_SIZE (default 1080x2400) screen at 420 dpi. `settings get system
# accelerometer_rotation|user_rotation` print $FAKE_ADB_ACCELEROMETER_ROTATION (default 1) and $FAKE_ADB_USER_ROTATION (default 0); `cmd uimode night` prints
# $FAKE_ADB_NIGHT (default no). With $FAKE_ADB_NETWORK_ON set, `svc wifi enable` makes `dumpsys connectivity` report
# that network and `svc wifi disable` takes it away again (state in $FAKE_ADB_STATE_DIR).
# `logcat -b crash -d` prints $FAKE_ADB_CRASH_LOG (default nothing) and returns.
# `getprop ro.build.version.sdk` prints $FAKE_ADB_SDK (default 34), `getprop persist.sys.locale` $FAKE_ADB_LOCALE
# (default en-US); `cmd locale set-app-locales ... --locales` fails when $FAKE_ADB_LOCALE_FAILS is set (camera-pose T-054).
# `log -t <tag> <text>` appends a logcat line to $FAKE_ADB_LOGCAT_FILE when set, then $FAKE_ADB_KILL_LINE when set
# (with FAKE_ADB_KILL_ONCE=1 only after the first line, counted in $FAKE_ADB_STATE_DIR/kills.n).
# The app process (camera-pose T-048) is only simulated when $FAKE_ADB_STATE_DIR is set; without it `pidof` prints nothing.
# With it: `am start -W` counts the starts in starts.n and leaves the process alive (file `alive`) once the count is
# above $FAKE_ADB_DEAD_STARTS (default 0); `pm clear` and `am force-stop` kill it; `pidof` prints 4242 while it is
# alive; a hanging subcommand writes its pid to hang.pid and, with FAKE_ADB_ALIVE_AFTER_HANG=1, leaves the process
# alive first (an app that starts slowly but runs). When $FAKE_ADB_PIDOF_TEXT is set, `pidof` prints it and returns 0
# (camera-pose T-049: an adb error with digits, or several pids).
[[ -n "${FAKE_ADB_CALLS:-}" ]] && echo "$*" >> "${FAKE_ADB_CALLS}"
case "$1" in
  get-state) [[ -n "${FAKE_ADB_NO_DEVICE:-}" ]] && exit 1; echo device ;;
  logcat)
    [[ " $* " == *" -c "* ]] && exit 0
    if [[ " $* " == *" -b crash "* && " $* " == *" -d "* ]]; then cat "${FAKE_ADB_CRASH_LOG:-/dev/null}"; exit 0; fi
    cat "${FAKE_ADB_LOGCAT:-/dev/null}"
    exec sleep 300 ;;
  shell)
    shift
    # With FAKE_ADB_HANG_ONCE=1 only the first matching call hangs (hang.pid exists afterwards).
    if [[ -n "${FAKE_ADB_HANG:-}" && "$*" == "${FAKE_ADB_HANG}"* && \
      ! ( "${FAKE_ADB_HANG_ONCE:-}" == 1 && -s "${FAKE_ADB_STATE_DIR:-/nonexistent}/hang.pid" ) ]]; then
      if [[ -n "${FAKE_ADB_STATE_DIR:-}" ]]; then
        mkdir -p "${FAKE_ADB_STATE_DIR}"
        echo "$$" > "${FAKE_ADB_STATE_DIR}/hang.pid"
        [[ "${FAKE_ADB_ALIVE_AFTER_HANG:-}" == 1 ]] && touch "${FAKE_ADB_STATE_DIR}/alive"
      fi
      exec sleep 300
    fi
    case "$*" in
      "uiautomator dump"*)
        if [[ -n "${FAKE_ADB_UI_SEQ:-}" ]]; then
          state="${FAKE_ADB_STATE_DIR:-${TMPDIR:-/tmp}}"
          mkdir -p "$state"
          read -r -a files <<<"${FAKE_ADB_UI_SEQ}"
          n="$(cat "$state/ui-seq.n" 2>/dev/null || echo 0)"
          (( n >= ${#files[@]} )) && n=$(( ${#files[@]} - 1 ))
          echo "${files[$n]}" > "$state/ui-seq.cur"
          echo $(( n + 1 )) > "$state/ui-seq.n"
          if [[ "${files[$n]}" == *.idle-error ]]; then echo "ERROR: could not get idle state."; exit 0; fi
          echo "UI hierarchy dumped to: /sdcard/ds.xml"
        fi ;;
      "wm size") echo "Physical size: ${FAKE_ADB_PHYSICAL_SIZE:-1080x2400}" ;;
      "wm density") echo "Physical density: 420" ;;
      "pm path"*) [[ -n "${FAKE_ADB_NO_APP:-}" ]] && exit 1; echo "package:/data/app/base.apk" ;;
      "getprop ro.build.version.sdk") echo "${FAKE_ADB_SDK:-34}" ;;
      "getprop persist.sys.locale") echo "${FAKE_ADB_LOCALE:-en-US}" ;;
      "log -t "*)
        [[ -z "${FAKE_ADB_LOGCAT_FILE:-}" ]] && exit 0
        echo "10-25 19:53:04.500  1000  1000 I $3: ${*:4}" >> "${FAKE_ADB_LOGCAT_FILE}"
        if [[ -n "${FAKE_ADB_KILL_LINE:-}" ]]; then
          state="${FAKE_ADB_STATE_DIR:-${TMPDIR:-/tmp}}"
          mkdir -p "$state"
          kills="$(cat "$state/kills.n" 2>/dev/null || echo 0)"
          if [[ "${FAKE_ADB_KILL_ONCE:-}" != 1 || "$kills" == 0 ]]; then
            echo "${FAKE_ADB_KILL_LINE}" >> "${FAKE_ADB_LOGCAT_FILE}"
          fi
          echo $(( kills + 1 )) > "$state/kills.n"
        fi
        exit 0 ;;
      "cmd locale set-app-locales"*"--locales"*)
        if [[ -n "${FAKE_ADB_LOCALE_FAILS:-}" ]]; then
          echo "Exception occurred while executing 'set-app-locales':"
          exit 255
        fi
        exit 0 ;;
      getprop*) echo Fake ;;
      "dumpsys package"*)
        echo "    versionName=0.1.0-staging.4"
        printf '    install permissions:\r\n      android.permission.INTERNET: granted=true\r\n'
        printf '    User 0: ceDataInode=1 installed=true\r\n      runtime permissions:\r\n'
        for p in ${FAKE_ADB_RUNTIME_PERMISSIONS:-}; do printf '        %s: granted=false, flags=[ ]\r\n' "$p"; done
        printf '      enabledComponents:\r\n' ;;
      "pm grant"*) [[ " ${FAKE_ADB_GRANT_FAILS:-} " == *" ${*: -1} "* ]] && exit 255; exit 0 ;;
      "dumpsys gfxinfo"*) printf 'Total frames rendered: 400\nJanky frames: 3 (0.75%%)\n' ;;
      "dumpsys meminfo"*) echo "        TOTAL PSS:    51234" ;;
      "find /sdcard"*) cat "${FAKE_ADB_FILES:-/dev/null}" ;;
      "dumpsys connectivity"*)
        network="${FAKE_ADB_NETWORK:-none}"
        if [[ -n "${FAKE_ADB_NETWORK_ON:-}" && -f "${FAKE_ADB_STATE_DIR:-${TMPDIR:-/tmp}}/network-on" ]]; then
          network="${FAKE_ADB_NETWORK_ON}"
        fi
        echo "Active default network: ${network}" ;;
      "svc wifi enable")
        if [[ -n "${FAKE_ADB_NETWORK_ON:-}" ]]; then
          mkdir -p "${FAKE_ADB_STATE_DIR:-${TMPDIR:-/tmp}}"
          : > "${FAKE_ADB_STATE_DIR:-${TMPDIR:-/tmp}}/network-on"
        fi ;;
      "svc wifi disable") rm -f "${FAKE_ADB_STATE_DIR:-${TMPDIR:-/tmp}}/network-on" ;;
      "settings get system accelerometer_rotation") echo "${FAKE_ADB_ACCELEROMETER_ROTATION:-1}" ;;
      "settings get system user_rotation") echo "${FAKE_ADB_USER_ROTATION:-0}" ;;
      "cmd uimode night") echo "Night mode: ${FAKE_ADB_NIGHT:-no}" ;;
      "cmd package query-activities"*)
        for a in ${FAKE_ADB_LAUNCHERS:-com.example.app/.MainActivity}; do
          printf '  Activity #0:\r\n    priority=0 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=false\r\n    %s\r\n' "$a"
        done ;;
      "am start -W"*)
        if [[ -n "${FAKE_ADB_STATE_DIR:-}" ]]; then
          mkdir -p "${FAKE_ADB_STATE_DIR}"
          starts=$(( $(cat "${FAKE_ADB_STATE_DIR}/starts.n" 2>/dev/null || echo 0) + 1 ))
          echo "$starts" > "${FAKE_ADB_STATE_DIR}/starts.n"
          (( starts > ${FAKE_ADB_DEAD_STARTS:-0} )) && touch "${FAKE_ADB_STATE_DIR}/alive"
        fi
        printf 'Status: ok\r\nTotalTime: 1234\r\n' ;;
      "pm clear"* | "am force-stop"*)
        [[ -n "${FAKE_ADB_STATE_DIR:-}" ]] && rm -f "${FAKE_ADB_STATE_DIR}/alive"
        exit 0 ;;
      "pidof"*)
        if [[ -n "${FAKE_ADB_PIDOF_TEXT:-}" ]]; then echo "${FAKE_ADB_PIDOF_TEXT}"; exit 0; fi
        [[ -z "${FAKE_ADB_STATE_DIR:-}" ]] && exit 0
        [[ -f "${FAKE_ADB_STATE_DIR}/alive" ]] || exit 1
        echo 4242 ;;
      monkey*) echo "Events injected: 1500" ;;
      *) exit 0 ;;
    esac ;;
  exec-out)
    if [[ "$*" == "exec-out cat"* ]]; then
      if [[ -n "${FAKE_ADB_UI_SEQ:-}" ]]; then
        current="$(cat "${FAKE_ADB_STATE_DIR:-${TMPDIR:-/tmp}}/ui-seq.cur" 2>/dev/null || true)"
        [[ -n "$current" && "$current" != *.idle-error ]] && cat "$current"
      else
        cat "${FAKE_ADB_UI:-/dev/null}"
      fi
    fi
    exit 0 ;;
  *) exit 0 ;;
esac
